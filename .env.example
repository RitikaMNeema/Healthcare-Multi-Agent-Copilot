# Set a real key to use live Claude calls. Leave unset to run the whole
# system - including the eval harness and test suite - fully offline against
# the deterministic mock backend.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# COPILOT_LLM_BACKEND=          # "claude" or "mock" - auto-detected from ANTHROPIC_API_KEY if unset
# COPILOT_PRIMARY_MODEL=claude-opus-5
# COPILOT_FALLBACK_MODELS=claude-sonnet-5,claude-haiku-4-5
# COPILOT_MAX_TOOL_ITERATIONS=4
# COPILOT_AUDIT_DB=data/audit.db
# COPILOT_CHECKPOINT_DB=data/checkpoints.db
# COPILOT_KB_DIR=data/knowledge_base
